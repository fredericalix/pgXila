# Copy this file to .env.local and fill in the values.
# .env.local is ignored by git: never commit real values.
#
# Every variable of .env.local is given to the server. The agent reads the
# token of its model from the one that is named in its settings (see
# scripts/set-agent.sh); the token itself is never stored in the database.

# API token of the model the agent calls, here for OpenRouter. A model that
# runs on this machine, with LM Studio for example, needs none.
OPENROUTER_API_KEY=
